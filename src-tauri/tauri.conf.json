{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHGate",
  "version": "../package.json",
  "identifier": "com.zouht.sshgate",
  "build": {
    "beforeDevCommand": "npx --no-install vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx --no-install vue-tsc --noEmit && npx --no-install vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSHGate",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
