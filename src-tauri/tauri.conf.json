{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHGate",
  "version": "../package.json",
  "identifier": "com.zouht.sshgate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSHGate",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
